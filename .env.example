# Copie para .env.local (ignorado pelo Git).
# Nada aqui e segredo: tudo que comeca com NEXT_PUBLIC_ vai para o pacote
# publico do navegador. Nunca coloque senha ou chave privada nestas variaveis.

# Caminho da API visto pelo navegador. Em desenvolvimento, o Next faz rewrite
# de /api para o backend local, entao o caminho relativo funciona sem mais nada.
NEXT_PUBLIC_API_BASE_URL=/api/v1

# Backend usado pelo rewrite do "npm run dev" (so em desenvolvimento).
BACKEND_URL=http://127.0.0.1:8080
