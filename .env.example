# Copie para .env.local (ignorado pelo Git).
# Nada aqui e segredo: tudo que comeca com VITE_ vai para o pacote publico
# do navegador. Nunca coloque senha ou chave privada nestas variaveis.

# Em desenvolvimento, o Vite faz proxy de /api para http://127.0.0.1:8080,
# entao o caminho relativo abaixo funciona sem configurar mais nada.
VITE_API_BASE_URL=/api/v1
