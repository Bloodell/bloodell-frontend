# Copie para .env.local (ignorado pelo Git).
# Nada aqui e segredo: tudo que comeca com NEXT_PUBLIC_ vai para o pacote
# publico do navegador. Nunca coloque senha ou chave privada nestas variaveis.

# Caminho da API visto pelo navegador. Em desenvolvimento, o Next faz rewrite
# de /api para o backend local, entao o caminho relativo funciona sem mais nada.
NEXT_PUBLIC_API_BASE_URL=/api/v1

# Backend usado pelo rewrite do "npm run dev" (so em desenvolvimento).
BACKEND_URL=http://127.0.0.1:8080

# Central logistica (/rastreamento). Os dois sao opcionais.
# Servico de roteamento OSRM-compativel que devolve a geometria das ruas. O padrao e o
# servidor publico de demonstracao do OSRM; em producao aponte para uma instancia propria.
# NEXT_PUBLIC_ROUTING_URL=https://router.project-osrm.org/route/v1/driving
# Estilo vetorial da base do mapa (padrao: OpenFreeMap "liberty", sem chave de API).
# NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
